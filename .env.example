# Website and analytics
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0
META_TEST_EVENT_CODE=

# Contentful
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_PREVIEW=false

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=ParkingOath Website <noreply@parkingoath.com.au>
LEADS_EMAIL_TO=apps@parkingoath.com

# Firebase Admin via Vercel OIDC / GCP Workload Identity Federation (server only)
FIREBASE_PROJECT_ID=
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_AUDIENCE=

# Ambassador referrals (server only)
AMBASSADOR_REFERRAL_SIGNING_SECRET=

# Firebase client (public configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Local emulators only; leave false in deployed environments
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
